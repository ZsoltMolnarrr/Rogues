{
  "schemaVersion": 1,
  "id": "rogues",
  "version": "${version}",
  "name": "Rogues & Warriors (RPG Series)",
  "description": "Silent Blades, Mighty Blows - Dominate with martial skills!",
  "authors": [
    "Daedelus"
  ],
  "contributors": [
    "Kenddie (Artwork)",
    "Ron (Artwork)"
  ],
  "contact": {
    "repo": "https://github.com/zsoltmolnarrr/Rogues",
    "issues": "https://github.com/ZsoltMolnarrr/Rogues/issues"
